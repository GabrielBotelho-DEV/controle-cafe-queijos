# ---------------------------------------------------------------------------
# Firebase Web App Configuration (Firebase Console > Projeto > Configurações >
# Seus aplicativos > Web app). Todas as variáveis são públicas no browser;
# a segurança real é feita com Firebase Auth + Regras do Cloud Firestore.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: medidor de uso do Firebase Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Opcional: habilita o botão "Carregar dados de teste" em produção.
# Por padrão os dados de teste só aparecem em desenvolvimento (npm run dev).
# NEXT_PUBLIC_ENABLE_SEED=false

# Opcional e recomendado: segredo do CAPTCHA leve da tela de login (servidor apenas,
# sem prefixo NEXT_PUBLIC). Gere um valor aleatório, ex.: openssl rand -hex 32.
# Use o MESMO valor no .env.local e nas variáveis da Vercel; sem ele, um valor padrão
# local é usado. Nunca exponha este valor no navegador.
CAPTCHA_SECRET=
